# Copy to .env.local for local development. Never commit .env.local.
# Every variable is read in exactly one place: lib/config.ts.

# --- Access ---
# Password for the single-owner gate (proxy.ts). Leave empty to run the app open
# locally. Required in production.
APP_PASSWORD=
# Random string used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Supabase ---
# Project URL and the service role key. The key never reaches the browser; all
# database and storage access goes through route handlers -> lib/db.ts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (recipe reasoning, restaurant research, photo analysis) ---
# Optional if you are logged in via `ant auth login`; the SDK finds the profile.
ANTHROPIC_API_KEY=
# Model used for generation and analysis. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# --- OpenAI (food photography and ingredient illustrations) ---
OPENAI_API_KEY=
# Defaults to gpt-image-2.5-flare. Any gpt-image-* model id works.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# --- Background work ---
# Shared secret for POST /api/worker (queue drain) and GET /api/cron/recommend
# (autonomous run trigger). Vercel sends CRON_SECRET automatically for crons.
# Generate with: openssl rand -hex 32
CRON_SECRET=
WORKER_SECRET=
# In development the server pokes its own worker every 30s (instrumentation.ts)
# because there is no pg_cron locally. Set to 0 to disable.
LOCAL_WORKER_HEARTBEAT=1
# Public origin of this deployment, used by the worker to re-trigger itself.
# Locally: http://localhost:3000. On Vercel this is derived from VERCEL_URL.
APP_ORIGIN=http://localhost:3000
