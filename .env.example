# Copy to .env.local for local development. Never commit .env.local.
# Every variable is read in exactly one place: lib/config.ts.

# --- Access (Google sign-in via Supabase Auth) ---
# Public values the browser uses to start sign-in. The anon key is safe to
# expose: data is only reachable with the service role key on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated Google account emails allowed in. Empty turns the gate off
# (local development only). Manually pre-approved for now.
ALLOWED_EMAILS=
# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Authorized redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
# Applied to the hosted project with `npx supabase config push`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Supabase ---
# Project URL and the service role key. The key never reaches the browser; all
# database and storage access goes through route handlers -> lib/db.ts.
# Locally these point at `npx supabase start`; on Vercel they point at the
# hosted project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed by scripts/copy-storage.mjs when moving a local library to the
# hosted project, and by `supabase link` / `db push`.
REMOTE_SUPABASE_URL=
REMOTE_SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# --- Anthropic (recipe reasoning, restaurant research, photo analysis) ---
# Optional if you are logged in via `ant auth login`; the SDK finds the profile.
ANTHROPIC_API_KEY=
# Model used for generation and analysis. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# --- OpenAI (food photography and ingredient illustrations) ---
OPENAI_API_KEY=
# Defaults to gpt-image-2.5-flare. Any gpt-image-* model id works.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Video model for method-step clips (sora-2 is the cheaper tier; sora-2-pro for fidelity).
OPENAI_VIDEO_MODEL=sora-2

# --- Background work ---
# Shared secret for POST /api/worker (queue drain) and GET /api/cron/recommend
# (autonomous run trigger). Vercel sends CRON_SECRET automatically for crons.
# Generate with: openssl rand -hex 32
CRON_SECRET=
WORKER_SECRET=
# In development the server pokes its own worker every 30s (instrumentation.ts)
# because there is no pg_cron locally. Set to 0 to disable.
LOCAL_WORKER_HEARTBEAT=1
# Public origin of this deployment, used by the worker to re-trigger itself.
# Locally: http://localhost:3000. On Vercel this is derived from VERCEL_URL.
APP_ORIGIN=http://localhost:3000
